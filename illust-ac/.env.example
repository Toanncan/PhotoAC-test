# ============================================================
# Environment Configuration — DO NOT COMMIT THE ACTUAL .env FILE
# Copy this file to .env and fill in your actual values
# ============================================================

# Application URL
BASE_URL=https://test-lien.ac-illust.com/

# HTTP Basic Auth for staging server (popup credentials when first accessing)
HTTP_USER=your-http-username
HTTP_PASS=your-http-password

# Premium User Credentials (Download member - Premium)
PREMIUM_USER_EMAIL=your-premium-email@example.com
PREMIUM_USER_PASSWORD=your-premium-password

# Free User Credentials (Download member - Free)
FREE_USER_EMAIL=your-free-email@example.com
FREE_USER_PASSWORD=your-free-password

# Creator Credentials
CREATOR_EMAIL=your-creator-email@example.com
CREATOR_PASSWORD=your-creator-password

# Admin Credentials (if applicable)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin-password

# Environment (local | staging | production)
ENV=staging

# Gmail Credentials (for email receipt verification)
GMAIL_EMAIL=your-gmail@gmail.com
GMAIL_PASSWORD=your-gmail-app-password

# Allure Report Settings (optional)
ALLURE_RESULTS_DIR=allure-results
